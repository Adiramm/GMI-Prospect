<?xml version="1.0" encoding="utf-8"?>
<!--
    Course list: toolbar, level tabs (Diploma / GAPP / GUFP) and ONE RecyclerView.
    Switching tab only swaps the adapter's data - no ViewPager, no Fragments.
    Tabs are added in CourseListActivity from the Level enum.
    fitsSystemWindows pads the screen away from the status/navigation bars.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".ui.CourseListActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.GMI.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLevels"
        style="@style/Widget.GMI.TabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- The id lets RecyclerView save its scroll position on rotation by itself -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCourses"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/spacing_small"
        android:paddingBottom="@dimen/spacing_medium"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_course" />
</LinearLayout>
