<?xml version="1.0" encoding="utf-8"?>
<!--
    Result screen. A FrameLayout so the ConfettiView can sit ON TOP of everything.
    Only one of the two content views is shown (set in ResultActivity):
      - recyclerResults: eligible → header + ranked course cards
      - scrollNotEligible: not eligible → message + missing requirements per level
    The Home button at the bottom is always visible.
    fitsSystemWindows pads the screen away from the status/navigation bars.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    tools:context=".ui.ResultActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.GMI.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />

        <!-- ===== Eligible ===== -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerResults"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/spacing_medium"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_result_course"
            tools:visibility="visible" />

        <!-- ===== Not eligible ===== -->
        <ScrollView
            android:id="@+id/scrollNotEligible"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding"
                android:paddingTop="@dimen/spacing_small"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingBottom="@dimen/spacing_large">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_icon_circle"
                    android:backgroundTint="?attr/colorPrimaryContainer"
                    android:importantForAccessibility="no"
                    android:padding="14dp"
                    android:src="@drawable/ic_school"
                    app:tint="?attr/colorOnPrimaryContainer" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:text="@string/result_not_eligible_title"
                    android:textAppearance="@style/TextAppearance.GMI.Headline" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/result_not_eligible_body"
                    android:textAppearance="@style/TextAppearance.GMI.Body"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <!-- One item_missing_level.xml card per level, added in code -->
                <LinearLayout
                    android:id="@+id/containerMissingLevels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonRetake"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_large"
                    android:text="@string/result_retake" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonContact"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/title_contact"
                    app:icon="@drawable/ic_call"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </ScrollView>

        <!-- ===== Always: back to Home ===== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonHome"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/spacing_small"
            android:layout_marginEnd="@dimen/screen_padding"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:text="@string/action_home"
            app:icon="@drawable/ic_home"
            app:iconGravity="textStart" />
    </LinearLayout>

    <!-- Confetti overlay: drawn above everything, does not take touches -->
    <com.gmi.prospect.ui.view.ConfettiView
        android:id="@+id/confettiView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />
</FrameLayout>
