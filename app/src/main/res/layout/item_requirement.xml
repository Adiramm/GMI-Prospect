<?xml version="1.0" encoding="utf-8"?>
<!-- One bullet in the entry-requirements list. Inflated once per line by
     CourseDetailActivity.showRequirements(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Dot sits roughly on the first text line -->
    <View
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginTop="9dp"
        android:background="@drawable/shape_bullet_dot"
        android:backgroundTint="?attr/colorPrimary" />

    <TextView
        android:id="@+id/textRequirement"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.GMI.Body"
        tools:text="Credit (C or better) in Mathematics" />
</LinearLayout>
