<?xml version="1.0" encoding="utf-8"?>
<!-- Not-eligible result: one card per level ("Diploma", "GAPP", "GUFP") listing
     what is still missing. Bullets (item_requirement.xml) are added in ResultActivity. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textLevelTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textAppearance="@style/TextAppearance.GMI.Title.Small"
            tools:text="@string/level_diploma" />

        <LinearLayout
            android:id="@+id/containerMissing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
