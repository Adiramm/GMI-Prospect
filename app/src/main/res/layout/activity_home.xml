<?xml version="1.0" encoding="utf-8"?>
<!--
    Home screen: gradient header (fixed) + scrollable 2x2 grid of cards.
    System-bar padding is added in HomeActivity.applyWindowInsets(): the header
    gets the status-bar height on top, the scroll content gets the
    navigation-bar height at the bottom.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.HomeActivity">

    <!-- ===== Gradient header ===== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_home"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/spacing_small"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="36dp">

        <ImageView
            android:id="@+id/imageLogo"
            android:layout_width="62dp"
            android:layout_height="44dp"
            android:contentDescription="@string/cd_gmi_logo"
            android:src="@drawable/gmi_logo_light"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Language toggle: shows the language you will switch TO ("BM" / "EN") -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonLanguage"
            style="@style/Widget.GMI.Button.Header"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:contentDescription="@string/cd_toggle_language"
            android:text="@string/lang_toggle_label"
            app:icon="@drawable/ic_translate"
            app:layout_constraintBottom_toBottomOf="@id/imageLogo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/imageLogo" />

        <!-- Theme toggle: icon + description are set in HomeActivity -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonTheme"
            style="@style/Widget.GMI.Button.Header.Icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="@dimen/spacing_small"
            android:contentDescription="@string/cd_switch_to_dark"
            app:icon="@drawable/ic_dark_mode"
            app:layout_constraintBottom_toBottomOf="@id/imageLogo"
            app:layout_constraintEnd_toStartOf="@id/buttonLanguage"
            app:layout_constraintTop_toTopOf="@id/imageLogo" />

        <TextView
            android:id="@+id/textGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="@dimen/spacing_medium"
            android:text="@string/home_greeting"
            android:textAppearance="@style/TextAppearance.GMI.Headline"
            android:textColor="@color/on_header"
            android:textSize="28sp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imageLogo" />

        <!-- Red dot motif: echoes the dot on the logo's "i". It starts at the
             greeting's top-left corner; HomeActivity.placeRedDot() then moves it
             above the last letter ("GMI" → the "I"), wherever the text ends. -->
        <View
            android:id="@+id/redDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/shape_red_dot"
            app:layout_constraintStart_toStartOf="@id/textGreeting"
            app:layout_constraintTop_toTopOf="@id/textGreeting" />

        <TextView
            android:id="@+id/textSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/home_subtitle"
            android:textAppearance="@style/TextAppearance.GMI.Body"
            android:textColor="@color/on_header_variant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textGreeting" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ===== Scrollable content ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="@dimen/screen_padding"
            android:paddingEnd="14dp"
            android:paddingBottom="@dimen/screen_padding">
            <!-- 14dp side padding + 6dp card margin = 20dp from the screen edge -->

            <TextView
                android:id="@+id/textSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="6dp"
                android:text="@string/home_section_title"
                android:textAppearance="@style/TextAppearance.GMI.Title" />

            <!-- Row 1: Courses | Check Eligibility -->
            <LinearLayout
                android:id="@+id/row1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCourses"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_icon_circle"
                            android:backgroundTint="?attr/colorPrimaryContainer"
                            android:importantForAccessibility="no"
                            android:padding="12dp"
                            android:src="@drawable/ic_school"
                            app:tint="?attr/colorOnPrimaryContainer" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_medium"
                            android:text="@string/title_courses"
                            android:textAppearance="@style/TextAppearance.GMI.Title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/home_courses_sub"
                            android:textAppearance="@style/TextAppearance.GMI.Label" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Main action: red icon circle as the "pop" -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardEligibility"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_icon_circle"
                            android:backgroundTint="?attr/colorTertiaryContainer"
                            android:importantForAccessibility="no"
                            android:padding="12dp"
                            android:src="@drawable/ic_task_alt"
                            app:tint="?attr/colorTertiary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_medium"
                            android:text="@string/title_eligibility"
                            android:textAppearance="@style/TextAppearance.GMI.Title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/home_eligibility_sub"
                            android:textAppearance="@style/TextAppearance.GMI.Label" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Row 2: About Us | Contact Us -->
            <LinearLayout
                android:id="@+id/row2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAbout"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_icon_circle"
                            android:backgroundTint="?attr/colorPrimaryContainer"
                            android:importantForAccessibility="no"
                            android:padding="12dp"
                            android:src="@drawable/ic_info"
                            app:tint="?attr/colorOnPrimaryContainer" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_medium"
                            android:text="@string/title_about"
                            android:textAppearance="@style/TextAppearance.GMI.Title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/home_about_sub"
                            android:textAppearance="@style/TextAppearance.GMI.Label" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardContact"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_icon_circle"
                            android:backgroundTint="?attr/colorPrimaryContainer"
                            android:importantForAccessibility="no"
                            android:padding="12dp"
                            android:src="@drawable/ic_call"
                            app:tint="?attr/colorOnPrimaryContainer" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_medium"
                            android:text="@string/title_contact"
                            android:textAppearance="@style/TextAppearance.GMI.Title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/home_contact_sub"
                            android:textAppearance="@style/TextAppearance.GMI.Label" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView
                android:id="@+id/textFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:gravity="center"
                android:text="@string/home_footer"
                android:textAppearance="@style/TextAppearance.GMI.Label" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
