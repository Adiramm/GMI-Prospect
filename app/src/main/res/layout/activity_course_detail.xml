<?xml version="1.0" encoding="utf-8"?>
<!--
    Course detail: scrollable info (header, facts card, description, entry
    requirements, medical note) + a fixed "Am I eligible?" button at the bottom.
    All text is filled in by CourseDetailActivity from the selected Course.
    fitsSystemWindows pads the screen away from the status/navigation bars.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".ui.CourseDetailActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.GMI.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/spacing_small"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/spacing_large">

            <!-- ===== Header: icon, name, optional badge ===== -->
            <ImageView
                android:id="@+id/imageCourseIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="?attr/colorPrimaryContainer"
                android:importantForAccessibility="no"
                android:padding="14dp"
                app:tint="?attr/colorOnPrimaryContainer"
                tools:src="@drawable/ic_bolt" />

            <TextView
                android:id="@+id/textCourseName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:textAppearance="@style/TextAppearance.GMI.Headline"
                tools:text="@string/course_mechatronics_name" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLimitedSeats"
                style="@style/Widget.GMI.Chip.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="@string/badge_limited_seats"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- ===== Facts card: level, faculty, duration ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/detail_label_level"
                            android:textAppearance="@style/TextAppearance.GMI.Label" />

                        <TextView
                            android:id="@+id/textLevel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:textAppearance="@style/TextAppearance.GMI.Body"
                            tools:text="@string/level_diploma" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/detail_label_faculty"
                            android:textAppearance="@style/TextAppearance.GMI.Label" />

                        <TextView
                            android:id="@+id/textFaculty"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:textAppearance="@style/TextAppearance.GMI.Body"
                            tools:text="@string/faculty_electrical" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/detail_label_duration"
                            android:textAppearance="@style/TextAppearance.GMI.Label" />

                        <TextView
                            android:id="@+id/textDuration"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:textAppearance="@style/TextAppearance.GMI.Body"
                            tools:text="@string/duration_3_years" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Description ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="@string/detail_about_title"
                android:textAppearance="@style/TextAppearance.GMI.Title" />

            <TextView
                android:id="@+id/textDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:lineSpacingExtra="3dp"
                android:textAppearance="@style/TextAppearance.GMI.Body"
                tools:text="@string/course_mechatronics_desc" />

            <!-- ===== Entry requirements (bullets added in code) ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="@string/detail_requirements_title"
                android:textAppearance="@style/TextAppearance.GMI.Title" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small">

                <LinearLayout
                    android:id="@+id/containerRequirements"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Medical note (diplomas only, not checked by the app) ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMedicalNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSecondaryContainer"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_info"
                        app:tint="?attr/colorOnSecondaryContainer" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_medical_title"
                            android:textAppearance="@style/TextAppearance.GMI.Title.Small"
                            android:textColor="?attr/colorOnSecondaryContainer" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/detail_medical_note"
                            android:textAppearance="@style/TextAppearance.GMI.Body"
                            android:textColor="?attr/colorOnSecondaryContainer" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- ===== Fixed bottom action ===== -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonCheckEligibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginBottom="@dimen/spacing_medium"
        android:text="@string/detail_check_eligibility"
        app:icon="@drawable/ic_task_alt"
        app:iconGravity="textStart" />
</LinearLayout>
