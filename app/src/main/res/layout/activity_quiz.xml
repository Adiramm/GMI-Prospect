<?xml version="1.0" encoding="utf-8"?>
<!--
    Interest quiz: progress at the top, one question with 4 answer cards in the
    middle (quizContent slides left/right between questions), Back / Next at the bottom.
    fitsSystemWindows pads the screen away from the status/navigation bars.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".ui.QuizActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.GMI.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <!-- ===== Progress: "Question 2 of 6" + bar ===== -->
    <TextView
        android:id="@+id/textProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:textAppearance="@style/TextAppearance.GMI.Label"
        tools:text="Question 2 of 6" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressQuiz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginEnd="@dimen/screen_padding"
        app:indicatorColor="?attr/colorPrimary"
        app:trackColor="?attr/colorSurfaceVariant"
        app:trackCornerRadius="4dp"
        app:trackThickness="8dp"
        tools:max="6"
        tools:progress="2" />

    <!-- ===== Question + answers (this block slides between questions) ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/quizContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/spacing_large"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/spacing_large">

            <TextView
                android:id="@+id/textQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.GMI.Headline"
                tools:text="@string/quiz_q1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="@dimen/spacing_small"
                android:text="@string/quiz_hint"
                android:textAppearance="@style/TextAppearance.GMI.Body"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <include
                android:id="@+id/answer0"
                layout="@layout/item_quiz_answer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <include
                android:id="@+id/answer1"
                layout="@layout/item_quiz_answer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <include
                android:id="@+id/answer2"
                layout="@layout/item_quiz_answer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <include
                android:id="@+id/answer3"
                layout="@layout/item_quiz_answer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </ScrollView>

    <!-- ===== Back / Next ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/spacing_small"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/spacing_medium">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonBack"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/action_back" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/action_next" />
    </LinearLayout>
</LinearLayout>
