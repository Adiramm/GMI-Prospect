    <!-- ========== Courses: Diploma - Electrical Engineering ========== -->
    <string name="course_mechatronics_name">Diploma Teknologi Kejuruteraan Mekatronik</string>
    <!-- TODO verify -->
    <string name="course_mechatronics_desc">Menggabungkan kejuruteraan mekanikal, elektrik dan kawalan untuk membina serta menyelenggara mesin automatik dan sistem robotik.</string>

    <string name="course_instrumentation_control_name">Diploma Teknologi Kejuruteraan (Instrumentasi &amp; Kawalan)</string>
    <!-- TODO verify -->
    <string name="course_instrumentation_control_desc">Memberi tumpuan kepada pengukuran, pemantauan dan kawalan proses industri menggunakan penderia, pengawal dan sistem automasi.</string>

    <string name="course_electronics_computer_name">Diploma Teknologi Kejuruteraan Elektronik (Komputer)</string>
    <!-- TODO verify -->
    <string name="course_electronics_computer_desc">Merangkumi litar elektronik, sistem terbenam dan perkakasan komputer, menyediakan anda untuk membina dan membaiki peranti berasaskan komputer.</string>

    <string name="course_autotronics_name">Diploma Teknologi Kejuruteraan Autotronik</string>
    <!-- TODO verify -->
    <string name="course_autotronics_desc">Merangkumi sistem elektrik dan elektronik dalam kenderaan moden, daripada pengurusan enjin hingga diagnostik.</string>

    <string name="course_sustainable_energy_name">Diploma Teknologi Kejuruteraan (Tenaga Lestari &amp; Pengagihan Kuasa)</string>
    <!-- TODO verify -->
    <string name="course_sustainable_energy_desc">Merangkumi penjanaan kuasa, pengagihan dan sistem tenaga boleh baharu, dengan tumpuan kepada bekalan elektrik yang cekap dan lestari.</string>

    <string name="course_industrial_communication_name">Sistem Komunikasi Industri</string>
    <!-- TODO verify -->
    <string name="course_industrial_communication_desc">Merangkumi rangkaian dan sistem komunikasi yang menghubungkan mesin dan pengawal di kilang moden.</string>

    <string name="course_facilities_automation_name">Automasi Fasiliti &amp; Bangunan</string>
    <!-- TODO verify -->
    <string name="course_facilities_automation_desc">Merangkumi automasi sistem bangunan seperti pencahayaan, penyaman udara, keselamatan dan pengurusan tenaga.</string>

    <!-- ========== Courses: Diploma - Mechanical Engineering ========== -->
    <string name="course_industrial_design_name">Diploma Teknologi Kejuruteraan (Reka Bentuk Industri)</string>
    <!-- TODO verify -->
    <string name="course_industrial_design_desc">Menggabungkan kemahiran kejuruteraan dan reka bentuk untuk menghasilkan produk yang berfungsi, selamat dan menarik.</string>

    <string name="course_industrial_quality_name">Diploma Teknologi Kejuruteraan Kualiti Industri</string>
    <!-- TODO verify -->
    <string name="course_industrial_quality_desc">Memberi tumpuan kepada kawalan kualiti, pemeriksaan dan kaedah pengukuran yang memastikan produk kilang memenuhi piawaian.</string>

    <string name="course_product_design_name">Diploma Teknologi Kejuruteraan Reka Bentuk Produk Inovatif</string>
    <!-- TODO verify -->
    <string name="course_product_design_desc">Membawa anda daripada idea hingga prototaip, menggunakan CAD, pengetahuan bahan dan prinsip kejuruteraan untuk mereka produk baharu.</string>

    <string name="course_cnc_precision_name">Diploma Teknologi Kejuruteraan Mekanikal (Kejituan CNC)</string>
    <!-- TODO verify -->
    <string name="course_cnc_precision_desc">Melatih anda memprogram dan mengendalikan mesin CNC untuk menghasilkan komponen mekanikal berketepatan tinggi.</string>

    <string name="course_manufacturing_name">Diploma Teknologi Kejuruteraan Mekanikal (Pembuatan)</string>
    <!-- TODO verify -->
    <string name="course_manufacturing_desc">Merangkumi proses pembuatan moden, pemesinan dan perancangan pengeluaran yang digunakan dalam industri.</string>

    <string name="course_tool_die_name">Teknologi Alat &amp; Acuan</string>
    <!-- TODO verify -->
    <string name="course_tool_die_desc">Merangkumi reka bentuk dan pembuatan alat, acuan tekan dan acuan yang digunakan dalam pengeluaran besar-besaran.</string>

    <!-- ========== Courses: Diploma - Computer & Information ========== -->
    <string name="course_software_engineering_name">Diploma Kejuruteraan Perisian</string>
    <string name="course_software_engineering_desc">Membina kecekapan yang diperlukan sepanjang proses pembangunan perisian, termasuk pengujian dan kualiti perisian.</string>

    <string name="course_creative_multimedia_name">Diploma Multimedia Kreatif</string>
    <string name="course_creative_multimedia_desc">Merangkumi keseluruhan aliran kerja seni digital 2D/3D — lukisan, pemodelan, tekstur, animasi dan rendering — menggunakan perisian standard industri dan studio rakaman.</string>

    <!-- ========== Courses: Pre-university ========== -->
    <string name="course_gapp_name">Program Persediaan A-Level Jerman (GAPP)</string>
    <string name="course_gapp_desc">20 bulan di GMI diikuti 6 bulan kursus intensif Bahasa Jerman (B2 / TestDAF) di Jerman, kemudian kemasukan ke Universiti Sains Gunaan di Jerman.</string>

    <string name="course_gufp_name">Program Asasi GMI–UTP (GUFP)</string>
    <string name="course_gufp_desc">Program asasi satu tahun (3 trimester) yang menyediakan anda untuk pengajian ijazah di Universiti Teknologi PETRONAS.</string>

