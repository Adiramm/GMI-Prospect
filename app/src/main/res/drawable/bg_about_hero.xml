<?xml version="1.0" encoding="utf-8"?>
<!-- About Us hero card: the GMI header gradient with all corners rounded like a card.
     header_gradient_* are overridden in values-night/colors.xml for dark mode,
     card_stroke_width in values-night/dimens.xml. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="@color/header_gradient_end"
        android:startColor="@color/header_gradient_start" />
    <corners android:radius="@dimen/card_corner_radius" />
    <!-- Same outline as the dark-mode cards (width is 0dp in light mode), so the
         dark end of the gradient does not melt into the blue_900 background. -->
    <stroke
        android:width="@dimen/card_stroke_width"
        android:color="@color/blue_700" />
</shape>
