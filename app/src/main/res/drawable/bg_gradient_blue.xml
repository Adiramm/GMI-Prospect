<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen GMI gradient (Splash). Colours switch automatically in dark mode
     because header_gradient_* are overridden in values-night/colors.xml. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- angle 315 = top-left to bottom-right -->
    <gradient
        android:angle="315"
        android:endColor="@color/header_gradient_end"
        android:startColor="@color/header_gradient_start" />
</shape>
