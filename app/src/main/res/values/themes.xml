<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        LIGHT theme. The same style name is redefined in values-night/themes.xml,
        so Android picks the right one automatically when night mode changes
        (which also recreates the Activity - a lifecycle event!).
        Shared, non-colour settings (fonts, shapes, component styles) live in
        Theme.GMIProspect below so they are written only once.
    -->
    <style name="Base.Theme.GMIProspect" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary = GMI blue -->
        <item name="colorPrimary">@color/blue_500</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/blue_100</item>
        <item name="colorOnPrimaryContainer">@color/blue_800</item>

        <!-- Secondary = softer blue (used by chips, selected states) -->
        <item name="colorSecondary">@color/blue_400</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/blue_100</item>
        <item name="colorOnSecondaryContainer">@color/blue_800</item>

        <!-- Tertiary = GMI red, our "pop" accent for badges and highlights -->
        <item name="colorTertiary">@color/red_500</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorTertiaryContainer">@color/red_50</item>
        <item name="colorOnTertiaryContainer">@color/red_700</item>

        <item name="colorError">@color/red_600</item>
        <item name="colorOnError">@color/white</item>

        <!-- Background, surfaces and text -->
        <item name="android:colorBackground">@color/neutral_50</item>
        <item name="colorOnBackground">@color/neutral_900</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/neutral_900</item>
        <item name="colorSurfaceVariant">@color/neutral_100</item>
        <item name="colorOnSurfaceVariant">@color/neutral_600</item>
        <item name="colorSurfaceContainerLowest">@color/white</item>
        <item name="colorSurfaceContainerLow">@color/white</item>
        <item name="colorSurfaceContainer">@color/neutral_100</item>
        <item name="colorSurfaceContainerHigh">@color/neutral_100</item>
        <item name="colorSurfaceContainerHighest">@color/neutral_200</item>
        <item name="colorOutline">@color/neutral_300</item>
        <item name="colorOutlineVariant">@color/neutral_200</item>

        <!-- Dark status/nav bar icons on our light background -->
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- App theme: colours from Base (light or night) + shared fonts and shapes. -->
    <style name="Theme.GMIProspect" parent="Base.Theme.GMIProspect">
        <!-- Manrope is the default font: every plain TextView starts with the
             Body appearance. (We do NOT set android:fontFamily on the theme -
             a theme-level font beats textAppearance, so headings would lose
             Plus Jakarta Sans.) -->
        <item name="android:textViewStyle">@style/Widget.GMI.TextView</item>

        <!-- Turn off Material 3's blue "elevation tint" so cards stay pure
             colorSurface (white in light mode, blue_800 in dark mode). -->
        <item name="elevationOverlayEnabled">false</item>

        <!-- Map Material 3 type roles to our TextAppearances (see styles.xml) so
             built-in components (toolbar title, buttons, chips) use GMI fonts too. -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.GMI.Headline</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.GMI.Headline</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.GMI.Headline</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.GMI.Title</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.GMI.Title</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.GMI.Body</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.GMI.Body</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.GMI.Button</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.GMI.Label</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.GMI.Label</item>

        <!-- Default component styles: rounded cards and pill buttons everywhere -->
        <item name="materialCardViewStyle">@style/Widget.GMI.Card</item>
        <item name="materialButtonStyle">@style/Widget.GMI.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.GMI.Button.Outlined</item>
        <item name="textInputStyle">@style/Widget.GMI.TextInputLayout</item>
    </style>

    <!--
        Splash screen theme. The window background is already the gradient, so
        there is no white flash before the layout is drawn. On Android 12+ the
        system's own splash (app icon) also uses GMI blue instead of white.
    -->
    <style name="Theme.GMIProspect.Splash">
        <item name="android:windowBackground">@drawable/bg_gradient_blue</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/header_gradient_start</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/splash_icon</item>
    </style>
</resources>
