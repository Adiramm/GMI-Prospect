    <!-- ========== Courses: Diploma - Electrical Engineering ========== -->
    <string name="course_mechatronics_name">Diploma of Mechatronics Engineering Technology</string>
    <!-- TODO verify -->
    <string name="course_mechatronics_desc">Combines mechanical, electrical and control engineering to build and maintain automated machines and robotic systems.</string>

    <string name="course_instrumentation_control_name">Diploma of Engineering Technology (Instrumentation &amp; Control)</string>
    <!-- TODO verify -->
    <string name="course_instrumentation_control_desc">Focuses on measuring, monitoring and controlling industrial processes using sensors, controllers and automation systems.</string>

    <string name="course_electronics_computer_name">Diploma of Electronics Engineering Technology (Computer)</string>
    <!-- TODO verify -->
    <string name="course_electronics_computer_desc">Covers electronic circuits, embedded systems and computer hardware, preparing you to build and troubleshoot computer-based devices.</string>

    <string name="course_autotronics_name">Diploma in Autotronics Engineering Technology</string>
    <!-- TODO verify -->
    <string name="course_autotronics_desc">Covers the electrical and electronic systems in modern vehicles, from engine management to diagnostics.</string>

    <string name="course_sustainable_energy_name">Diploma in Engineering Technology (Sustainable Energy &amp; Power Distribution)</string>
    <!-- TODO verify -->
    <string name="course_sustainable_energy_desc">Covers power generation, distribution and renewable energy systems, with a focus on efficient and sustainable electricity supply.</string>

    <string name="course_industrial_communication_name">Industrial Communication System</string>
    <!-- TODO verify -->
    <string name="course_industrial_communication_desc">Covers the networks and communication systems that connect machines and controllers in modern factories.</string>

    <string name="course_facilities_automation_name">Facilities &amp; Building Automation</string>
    <!-- TODO verify -->
    <string name="course_facilities_automation_desc">Covers the automation of building systems such as lighting, air-conditioning, security and energy management.</string>

    <!-- ========== Courses: Diploma - Mechanical Engineering ========== -->
    <string name="course_industrial_design_name">Diploma in Engineering Technology (Industrial Design)</string>
    <!-- TODO verify -->
    <string name="course_industrial_design_desc">Combines engineering and design skills to create products that are functional, safe and attractive.</string>

    <string name="course_industrial_quality_name">Diploma in Industrial Quality Engineering Technology</string>
    <!-- TODO verify -->
    <string name="course_industrial_quality_desc">Focuses on quality control, inspection and measurement methods that keep manufactured products up to standard.</string>

    <string name="course_product_design_name">Diploma in Innovative Product Design Engineering Technology</string>
    <!-- TODO verify -->
    <string name="course_product_design_desc">Takes you from idea to prototype, using CAD, materials knowledge and engineering principles to design new products.</string>

    <string name="course_cnc_precision_name">Diploma of Mechanical Engineering Technology (CNC Precision)</string>
    <!-- TODO verify -->
    <string name="course_cnc_precision_desc">Trains you to program and operate CNC machines to produce high-precision mechanical parts.</string>

    <string name="course_manufacturing_name">Diploma of Mechanical Engineering Technology (Manufacturing)</string>
    <!-- TODO verify -->
    <string name="course_manufacturing_desc">Covers modern manufacturing processes, machining and production planning used in industry.</string>

    <string name="course_tool_die_name">Tool &amp; Die Technology</string>
    <!-- TODO verify -->
    <string name="course_tool_die_desc">Covers the design and making of tools, dies and moulds used in mass production.</string>

    <!-- ========== Courses: Diploma - Computer & Information ========== -->
    <string name="course_software_engineering_name">Diploma in Software Engineering</string>
    <string name="course_software_engineering_desc">Develops the competencies needed across the software development process, including software testing and quality.</string>

    <string name="course_creative_multimedia_name">Diploma in Creative Multimedia</string>
    <string name="course_creative_multimedia_desc">Covers the full 2D/3D digital art pipeline — drawing, modelling, texturing, animation and rendering — using industry-standard tools and a recording studio.</string>

    <!-- ========== Courses: Pre-university ========== -->
    <string name="course_gapp_name">German A-Level Preparatory Programme (GAPP)</string>
    <string name="course_gapp_desc">20 months at GMI followed by 6 months of intensive German (B2 / TestDAF) in Germany, then entry to a German University of Applied Sciences.</string>

    <string name="course_gufp_name">GMI–UTP Foundation Programme (GUFP)</string>
    <string name="course_gufp_desc">A one-year foundation programme (3 trimesters) that prepares you for degree studies at Universiti Teknologi PETRONAS.</string>

